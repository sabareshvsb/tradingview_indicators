//@version=6
indicator("Smart Confluence BUY SELL • FVG • Liquidity • Fib", overlay=true,
     max_labels_count=500, max_lines_count=200, max_boxes_count=200)

//──────────────────────────────────────────────────────────────────────────────
// INPUTS
//──────────────────────────────────────────────────────────────────────────────

// Trend
groupTrend  = "1 • Trend"
emaLen      = input.int(50, "Trend EMA Length", minval=1, group=groupTrend)
emaSlopeLen = input.int(3, "EMA Slope Lookback", minval=1, group=groupTrend)
showEMA     = input.bool(true, "Show Red Trend EMA", group=groupTrend)

// Market Structure
groupMS  = "2 • Market Structure"
pivotLen = input.int(5, "Swing Pivot Length", minval=2, maxval=30, group=groupMS)
showSR   = input.bool(true, "Show Support / Resistance", group=groupMS)
showTL   = input.bool(true, "Show Trendlines", group=groupMS)

// Liquidity
groupLiq      = "3 • Liquidity Sweeps"
showLiquidity = input.bool(true, "Show Liquidity Sweeps", group=groupLiq)
requireSweep  = input.bool(false, "Require Liquidity Sweep", group=groupLiq)

// Momentum
groupMom     = "4 • RSI + MACD"
rsiLen       = input.int(14, "RSI Length", minval=2, group=groupMom)
rsiBullLevel = input.float(50, "Bullish RSI Level", minval=1, maxval=99, group=groupMom)
rsiBearLevel = input.float(50, "Bearish RSI Level", minval=1, maxval=99, group=groupMom)

macdFast   = input.int(12, "MACD Fast", minval=1, group=groupMom)
macdSlow   = input.int(26, "MACD Slow", minval=2, group=groupMom)
macdSignal = input.int(9, "MACD Signal", minval=1, group=groupMom)

// Fibonacci
groupFib    = "5 • Fibonacci"
showFib     = input.bool(true, "Show Fibonacci Levels", group=groupFib)
fibLookback = input.int(100, "Fib Search Lookback", minval=20, group=groupFib)

// Fair Value Gap (FVG)
groupFVG = "6 • FVG / IFVG"
showFVG  = input.bool(true, "Show Fair Value Gaps", group=groupFVG)
showIFVG = input.bool(true, "Show Inverted FVG", group=groupFVG)
maxFVG   = input.int(30, "Maximum FVG Boxes", minval=5, maxval=100, group=groupFVG)

// Signal Engine
groupSignal  = "7 • Signal Engine"
signalMode   = input.string("Balanced", "Signal Mode", options=["Strict", "Balanced", "Aggressive"], group=groupSignal)
cooldownBars = input.int(5, "Signal Cooldown Bars", minval=0, group=groupSignal)
showScore    = input.bool(true, "Show Confluence Score", group=groupSignal)

// Alerts
groupAlert   = "8 • Alerts"
enableAlerts = input.bool(true, "Enable Alert Conditions", group=groupAlert)


//──────────────────────────────────────────────────────────────────────────────
// CALCULATIONS & INDICATORS
//──────────────────────────────────────────────────────────────────────────────

// Dynamic ATR padding
atrVal = ta.atr(14)

// Trend EMA
ema        = ta.ema(close, emaLen)
emaRising  = ema > ema[emaSlopeLen]
emaFalling = ema < ema[emaSlopeLen]

bullTrend = close > ema and emaRising
bearTrend = close < ema and emaFalling

plot(showEMA ? ema : na, title="Trend EMA", color=color.rgb(190, 75, 55), linewidth=2)

// RSI
rsi     = ta.rsi(close, rsiLen)
rsiBull = rsi > rsiBullLevel
rsiBear = rsi < rsiBearLevel

// MACD
[macdLine, signalLine, macdHist] = ta.macd(close, macdFast, macdSlow, macdSignal)
macdBull = macdLine > signalLine and macdHist >= 0
macdBear = macdLine < signalLine and macdHist <= 0

// Swing Highs & Lows
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

var float high1 = na, var float high2 = na
var int highBar1 = na, var int highBar2 = na

var float low1 = na, var float low2 = na
var int lowBar1 = na, var int lowBar2 = na

if not na(ph)
    high2    := high1
    highBar2 := highBar1
    high1    := ph
    highBar1 := bar_index - pivotLen

if not na(pl)
    low2    := low1
    lowBar2 := lowBar1
    low1    := pl
    lowBar1 := bar_index - pivotLen

// Dynamic S/R Lines
var line srResLine = na
var line srSupLine = na

if showSR and not na(ph)
    line.delete(srResLine)
    srResLine := line.new(highBar1, high1, bar_index, high1, extend=extend.right, color=color.new(color.red, 40), width=1)

if showSR and not na(pl)
    line.delete(srSupLine)
    srSupLine := line.new(lowBar1, low1, bar_index, low1, extend=extend.right, color=color.new(color.blue, 40), width=1)

// Dynamic Trendlines
var line bearishTL = na
var line bullishTL = na

if showTL and not na(ph) and not na(high2) and not na(highBar2)
    line.delete(bearishTL)
    bearishTL := line.new(highBar2, high2, highBar1, high1, extend=extend.right, color=color.new(color.red, 30), width=2)

if showTL and not na(pl) and not na(low2) and not na(lowBar2)
    line.delete(bullishTL)
    bullishTL := line.new(lowBar2, low2, lowBar1, low1, extend=extend.right, color=color.new(color.green, 30), width=2)

// Trendline Breaks
float resistanceValue = na
float supportValue    = na

if not na(highBar1) and not na(highBar2) and highBar1 != highBar2
    highSlope = (high1 - high2) / (highBar1 - highBar2)
    resistanceValue := high1 + highSlope * (bar_index - highBar1)

if not na(lowBar1) and not na(lowBar2) and lowBar1 != lowBar2
    lowSlope = (low1 - low2) / (lowBar1 - lowBar2)
    supportValue := low1 + lowSlope * (bar_index - lowBar1)

bullTrendlineBreak = not na(resistanceValue) and close > resistanceValue and close[1] <= resistanceValue[1]
bearTrendlineBreak = not na(supportValue) and close < supportValue and close[1] >= supportValue[1]

// Liquidity Sweeps
bullSweep = not na(low1) and low < low1 and close > low1
bearSweep = not na(high1) and high > high1 and close < high1

plotshape(showLiquidity and bullSweep, title="Bullish Liquidity Sweep", style=shape.circle, location=location.belowbar, size=size.tiny, color=color.green, text="LS")
plotshape(showLiquidity and bearSweep, title="Bearish Liquidity Sweep", style=shape.circle, location=location.abovebar, size=size.tiny, color=color.red, text="LS")

// Fibonacci Retracements
highestPrice = ta.highest(high, fibLookback)
lowestPrice  = ta.lowest(low, fibLookback)
fibRange     = highestPrice - lowestPrice

fib214 = lowestPrice + fibRange * 0.214
fib382 = lowestPrice + fibRange * 0.382
fib500 = lowestPrice + fibRange * 0.500
fib618 = lowestPrice + fibRange * 0.618
fib705 = lowestPrice + fibRange * 0.705
fib786 = lowestPrice + fibRange * 0.786

plot(showFib ? fib382 : na, "Fib 38.2", color=color.new(color.gray, 65))
plot(showFib ? fib500 : na, "Fib 50.0", color=color.new(color.gray, 55))
plot(showFib ? fib618 : na, "Fib 61.8", color=color.new(color.orange, 30), linewidth=2)
plot(showFib ? fib705 : na, "Fib 70.5", color=color.new(color.gray, 55))
plot(showFib ? fib786 : na, "Fib 78.6", color=color.new(color.gray, 65))

// Fair Value Gaps (FVG)
bullFVG = low > high[2]
bearFVG = high < low[2]

var box[] bullBoxes = array.new_box()
var box[] bearBoxes = array.new_box()

if showFVG and bullFVG
    array.push(bullBoxes, box.new(left=bar_index - 2, top=low, right=bar_index, bottom=high[2], bgcolor=color.new(color.green, 88), border_color=color.new(color.green, 60)))

if showFVG and bearFVG
    array.push(bearBoxes, box.new(left=bar_index - 2, top=low[2], right=bar_index, bottom=high, bgcolor=color.new(color.red, 88), border_color=color.new(color.red, 60)))

if showFVG
    if array.size(bullBoxes) > 0
        for i = array.size(bullBoxes) - 1 to 0
            b = array.get(bullBoxes, i)
            box.set_right(b, bar_index)
            if close < box.get_bottom(b)
                if showIFVG
                    box.set_bgcolor(b, color.new(color.red, 90))
                    box.set_border_color(b, color.new(color.red, 50))
                else
                    box.delete(b)
                    array.remove(bullBoxes, i)

    if array.size(bearBoxes) > 0
        for i = array.size(bearBoxes) - 1 to 0
            b = array.get(bearBoxes, i)
            box.set_right(b, bar_index)
            if close > box.get_top(b)
                if showIFVG
                    box.set_bgcolor(b, color.new(color.green, 90))
                    box.set_border_color(b, color.new(color.green, 50))
                else
                    box.delete(b)
                    array.remove(bearBoxes, i)

while array.size(bullBoxes) > maxFVG
    box.delete(array.shift(bullBoxes))

while array.size(bearBoxes) > maxFVG
    box.delete(array.shift(bearBoxes))


//──────────────────────────────────────────────────────────────────────────────
// CONFLUENCE SCORE & SIGNALS
//──────────────────────────────────────────────────────────────────────────────

bullPriceConfirmation = close > ema
bearPriceConfirmation = close < ema

bullScore = (bullTrend ? 1 : 0) + (bullPriceConfirmation ? 1 : 0) + (rsiBull ? 1 : 0) + (macdBull ? 1 : 0) + (bullTrendlineBreak ? 1 : 0) + (bullSweep ? 1 : 0)
bearScore = (bearTrend ? 1 : 0) + (bearPriceConfirmation ? 1 : 0) + (rsiBear ? 1 : 0) + (macdBear ? 1 : 0) + (bearTrendlineBreak ? 1 : 0) + (bearSweep ? 1 : 0)

requiredScore = signalMode == "Strict" ? 6 : signalMode == "Balanced" ? 5 : 4

bullSignalRaw = bullScore >= requiredScore and (not requireSweep or bullSweep)
bearSignalRaw = bearScore >= requiredScore and (not requireSweep or bearSweep)

var int lastBuyBar  = na
var int lastSellBar = na

buyAllowed  = na(lastBuyBar) or (bar_index - lastBuyBar > cooldownBars)
sellAllowed = na(lastSellBar) or (bar_index - lastSellBar > cooldownBars)

buySignal  = bullSignalRaw and buyAllowed and barstate.isconfirmed
sellSignal = bearSignalRaw and sellAllowed and barstate.isconfirmed

if buySignal
    lastBuyBar := bar_index

if sellSignal
    lastSellBar := bar_index


//──────────────────────────────────────────────────────────────────────────────
// CHART-LOCKED DYNAMIC LABELS
//──────────────────────────────────────────────────────────────────────────────

if buySignal
    label.new(
         x=bar_index,
         y=low - (atrVal * 0.3),
         text=showScore ? "BUY\n" + str.tostring(bullScore) + "/6" : "BUY",
         xloc=xloc.bar_index,
         yloc=yloc.price,
         style=label.style_label_up,
         color=color.rgb(58, 130, 91),
         textcolor=color.white,
         size=size.small)

if sellSignal
    label.new(
         x=bar_index,
         y=high + (atrVal * 0.3),
         text=showScore ? "SELL\n" + str.tostring(bearScore) + "/6" : "SELL",
         xloc=xloc.bar_index,
         yloc=yloc.price,
         style=label.style_label_down,
         color=color.rgb(205, 91, 63),
         textcolor=color.white,
         size=size.small)


//──────────────────────────────────────────────────────────────────────────────
// ALERTS & INFORMATION TABLE
//──────────────────────────────────────────────────────────────────────────────

alertcondition(enableAlerts and buySignal, title="SMART BUY", message="SMART BUY signal: Confluence detected.")
alertcondition(enableAlerts and sellSignal, title="SMART SELL", message="SMART SELL signal: Confluence detected.")
alertcondition(enableAlerts and bullSweep, title="Bullish Liquidity Sweep", message="Bullish liquidity sweep detected.")
alertcondition(enableAlerts and bearSweep, title="Bearish Liquidity Sweep", message="Bearish liquidity sweep detected.")

var table infoTable = table.new(position.top_right, 2, 7, border_width=1)

if barstate.islast
    table.cell(infoTable, 0, 0, "SMART SIGNAL", text_color=color.white)
    table.cell(infoTable, 1, 0, signalMode, text_color=color.white)
    table.cell(infoTable, 0, 1, "TREND")
    table.cell(infoTable, 1, 1, bullTrend ? "BULLISH" : bearTrend ? "BEARISH" : "NEUTRAL")
    table.cell(infoTable, 0, 2, "RSI")
    table.cell(infoTable, 1, 2, str.tostring(rsi, "#.0"))
    table.cell(infoTable, 0, 3, "MACD")
    table.cell(infoTable, 1, 3, macdBull ? "BULLISH" : macdBear ? "BEARISH" : "NEUTRAL")
    table.cell(infoTable, 0, 4, "BUY SCORE")
    table.cell(infoTable, 1, 4, str.tostring(bullScore) + "/6")
    table.cell(infoTable, 0, 5, "SELL SCORE")
    table.cell(infoTable, 1, 5, str.tostring(bearScore) + "/6")
    table.cell(infoTable, 0, 6, "LIQUIDITY")
    table.cell(infoTable, 1, 6, bullSweep ? "BUY SWEEP" : bearSweep ? "SELL SWEEP" : "NONE")